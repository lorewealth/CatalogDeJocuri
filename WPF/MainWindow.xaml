<Window x:Class="WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF"
        mc:Ignorable="d"
        Title="WPF" Height="500" Width="800"
        WindowStyle="SingleBorderWindow"
        WindowState="Maximized"
        Background="Bisque">
    <StackPanel>
        <Label Content="Afisarea Jocurilor" HorizontalAlignment="Center" FontSize="30" FontWeight="Bold"/>
        <Border Name="DescJocuri" CornerRadius="10" Background="White" Padding="15" HorizontalAlignment="Center" MaxHeight="400" Width="400" VerticalAlignment="Top" Margin="0,0,0,10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Direction="270" Opacity="0.5"/>
            </Border.Effect>
            <ScrollViewer VerticalScrollBarVisibility="Visible">
                <TextBlock x:Name="DescJocSing" Text="" TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>

    </StackPanel>
</Window>