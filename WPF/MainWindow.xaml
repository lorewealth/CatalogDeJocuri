<Window x:Class="Lab6.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab6"
        mc:Ignorable="d"
        Title="WPF" Height="400" Width="800"
        WindowStyle="SingleBorderWindow"
        WindowState="Maximized">
    <Grid Background="Bisque">
        <Label Name="DescJoc" Content="Detalii Jocului: "
               HorizontalAlignment="Center"
               VerticalAlignment="Top"
               FontSize="25"/>
        <Border CornerRadius="10" Background="White" Padding="15" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,45,0,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Direction="270" Opacity="0.5"/>
            </Border.Effect>
            <StackPanel>
                <Label Name="ID" Content="ID: 1"/>
                <Label Name="Denumirea" Content="Denumirea: Crusader Kings III"/>
                <Label Name="Pretul" Content="Pretul: $9,99"/>
                <Label Name="Rating" Content="Rating: 9,1/10"/>
                <Label Name="Genre" Content="Genre: "/>
                <StackPanel Margin="50, 0, 0, 0">
                    <Label Content="[Medieval]" Padding="0"/>
                    <Label Content="[Strategy]" Padding="0"/>
                    <Label Content="[Grand Strategy]" Padding="0"/>
                </StackPanel>
                <Label Name="Platforme" Content="Platforme:"/>
                <StackPanel Margin="50, 0, 0, 0">
                    <Label Content="[Steam]" Padding="0"/>
                </StackPanel>
                <Label Name="Dezvolatori" Content="Dezvoltatori: "/>
                <StackPanel Margin="50, 0, 0, 0">
                    <Label Content="[Paradox Development Studio]" Padding="0"/>
                </StackPanel>
                <Label Name="Editori" Content="Editori: "/>
                <StackPanel Margin="50, 0, 0, 0">
                    <Label Content="[Paradox Interactive]" Padding="0"/>
                </StackPanel>
                <Label Name="Varsta" Content="Rating de Varsta: PEGI12"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>