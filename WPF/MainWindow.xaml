<Window x:Class="WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF"
        mc:Ignorable="d"
        Title="Catalog de Jocuri" Height="500" Width="800"
        WindowStyle="SingleBorderWindow"
        WindowState="Maximized"
        Background="Bisque">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Background="Beige">
            <StackPanel.Resources>
                <Style TargetType="Button">
                    <Setter Property="Margin" Value="5, 5, 5, 5"/>
                    <Setter Property="Height" Value="50"/>
                </Style>
            </StackPanel.Resources>
            <Button Content="Administrarea Jocurilor" Click="AdministrJocuriClick"/>
            <Button Content="Cauta" Click="CautareJocClick"/>
        </StackPanel>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel x:Name="AdministJocPanel" Visibility="Visible" Grid.Row="0">
                <Label Content="Introducerea Jocului" HorizontalAlignment="Center" FontSize="30" FontWeight="Bold"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.Resources>
                        <Style TargetType="StackPanel">
                            <Setter Property="Margin" Value="5,0,5,10"/>
                        </Style>
                    </Grid.Resources>
                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <Label Content="Denumirea" Padding="0" HorizontalAlignment="Center"/>
                        <TextBox x:Name="Denumirea" Height="25" Width="Auto"/>
                        <TextBlock x:Name="ErrDenumirea" Text="Denumirea Invalida" Foreground="Crimson" Visibility="Collapsed"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" >
                        <Label Content="Pret" Padding="0" HorizontalAlignment="Center"/>
                        <TextBox x:Name="Pret" Height="25" Width="Auto"/>
                        <TextBlock x:Name="ErrPret" Text="Pret Invalid" Foreground="Crimson" Visibility="Collapsed"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2">
                        <Label Content="Genre" Padding="0" HorizontalAlignment="Center"/>
                        <TextBox x:Name="Genre" Height="25" Width="Auto"/>
                        <TextBlock x:Name="ErrGenre" Text="Genre Invalide" Foreground="Crimson" Visibility="Collapsed"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="3">
                        <Label Content="Platforme" Padding="0" HorizontalAlignment="Center"/>
                        <ComboBox x:Name="SelectatorPlatforme" Height="25" SelectedIndex="0" HorizontalContentAlignment="Stretch">
                            <ComboBox.Items>
                                <ComboBoxItem Content="-- Selecteaza --"/>
                                <CheckBox Content="Steam"/>
                                <CheckBox Content="EpicGames"/>
                                <CheckBox Content="GOG"/>
                                <CheckBox Content="itchIo"/>
                            </ComboBox.Items>
                        </ComboBox>
                        <TextBlock x:Name="ErrPlatforme" Text="Platforme Invalide" Foreground="Crimson" Visibility="Collapsed"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0">
                        <Label Content="Rate(1-10)" Padding="0" HorizontalAlignment="Center"/>
                        <TextBox x:Name="Rate" Height="25" Width="Auto"/>
                        <TextBlock x:Name="ErrRate" Text="Rate Invalid" Foreground="Crimson" Visibility="Collapsed"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1">
                        <Label Content="Editori" Padding="0" HorizontalAlignment="Center"/>
                        <TextBox x:Name="Editori" Height="25" Width="Auto"/>
                        <TextBlock x:Name="ErrEditori" Text="Editori Invalide" Foreground="Crimson" Visibility="Collapsed"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2">
                        <Label Content="Dezvoltatori" Padding="0" HorizontalAlignment="Center"/>
                        <TextBox x:Name="Dezvoltatori" Height="25" Width="Auto"/>
                        <TextBlock x:Name="ErrDezvoltatori" Text="Dezvoltatori Invalide" Foreground="Crimson" Visibility="Collapsed"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="3">
                        <Label Content="Varsta(PEGI3-PEGI18)" Padding="0" HorizontalAlignment="Center"/>
                        <ComboBox x:Name="SelectatorVarsta" SelectedIndex="0" Height="25">
                            <ComboBoxItem Content="-- Selecteaza --"/>
                            <ComboBoxItem Content="PEGI3"/>
                            <ComboBoxItem Content="PEGI7"/>
                            <ComboBoxItem Content="PEGI12"/>
                            <ComboBoxItem Content="PEGI16"/>
                            <ComboBoxItem Content="PEGI18"/>
                        </ComboBox>
                        <TextBlock x:Name="ErrVarsta" Text="Rating de Varsta Invalida" Foreground="Crimson" Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>
                <StackPanel>
                    <Label Content="Anul: " Padding="0" HorizontalAlignment="Center"/>
                    <TextBox x:Name="Anul" HorizontalAlignment="Center" Height="25" Width="100"/>
                    <TextBlock x:Name="ErrAnul" Text="Anul Invalid" Foreground="Crimson" Visibility="Collapsed" HorizontalAlignment="Center" Width="Auto"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <StackPanel.Resources>
                        <Style TargetType="Button">
                            <Setter Property="Margin" Value="5"/>
                        </Style>
                    </StackPanel.Resources>
                    <StackPanel></StackPanel>
                    <Button Content="Adauga Joc" Click="AdaugaJocClick" Width="90" Height="30"/>
                    <Button Content="Sterge Ultimul Joc" Click="StergeUltJocClick" Width="120" Height="30"/>
                </StackPanel>
                <TextBlock x:Name="Rezultat" Text="" Padding="5" Width="Auto" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                <Border Name="DescJocuri" CornerRadius="10" Background="White" Padding="15" HorizontalAlignment="Center" MaxHeight="400" Width="400" VerticalAlignment="Top" Margin="0,0,0,10" Visibility="Collapsed">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" Direction="270" Opacity="0.5"/>
                    </Border.Effect>
                    <ScrollViewer VerticalScrollBarVisibility="Visible">
                        <TextBlock x:Name="DescJocSing" Text="" TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Border>
            </StackPanel>
            <DataGrid 
                x:Name="dgJocuri"
                Grid.Row="6"
                Grid.Column="1"
                AutoGenerateColumns="False"
                RowHeight="26"
                GridLinesVisibility="All"
                HeadersVisibility="Column"
                AlternatingRowBackground="#F5F5F5"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                IsReadOnly="True"
                Margin="5,5,5,5"
                >
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Width="Auto" Binding="{Binding InternalId}"/>
                    <DataGridTextColumn Header="Denumirea" Width="Auto" Binding="{Binding Denumirea}"/>
                    <DataGridTextColumn Header="Pret" Width="Auto" Binding="{Binding Pret}"/>
                    <DataGridTextColumn Header="Genre" Width="Auto" Binding="{Binding GenreStr}"/>
                    <DataGridTextColumn Header="Platforme" Width="Auto" Binding="{Binding Platforme}"/>
                    <DataGridTextColumn Header="Rate" Width="Auto" Binding="{Binding Rate}"/>
                    <DataGridTextColumn Header="Editori" Width="Auto" Binding="{Binding EditoriStr}"/>
                    <DataGridTextColumn Header="Dezvoltatori" Width="Auto" Binding="{Binding DezvoltatoriStr}"/>
                    <DataGridTextColumn Header="Varsta" Width="Auto" Binding="{Binding Varsta}"/>
                    <DataGridTextColumn Header="Anul" Width="Auto" Binding="{Binding Anul}"/>
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel x:Name="CautareJoculPanel" Visibility="Collapsed">
                <Label Content="Cautarea Jocului" HorizontalAlignment="Center" FontSize="30" FontWeight="Bold"/>
                <Label Content="Denumirea: " Margin="30,0,0,0"/>
                <TextBox x:Name="CautareBox" Width="500" Height="40" FontSize="20" VerticalContentAlignment="Center"/>
                <Button Content="Cauti" Click="CautareJocClick" Width="80" Height="40" Margin="5,5,5,5"/>
                <Border Name="DescJocuriCautare" CornerRadius="10" Background="White" Padding="15" HorizontalAlignment="Center" MaxHeight="400" Width="400" VerticalAlignment="Top" Margin="0,0,0,10" Visibility="Collapsed">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" Direction="270" Opacity="0.5"/>
                    </Border.Effect>
                    <ScrollViewer VerticalScrollBarVisibility="Visible">
                        <TextBlock x:Name="DescJocSingCaut" Text="" TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>